{
  "name": "orchboard",
  "version": "0.0.0",
  "description": "An agentic project board for Claude Code and Codex: plan, queue, and track your AI coding agents across every project.",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "agentic",
    "project-board",
    "kanban",
    "orchestration",
    "developer-tools"
  ],
  "homepage": "https://github.com/Blaketon/orchboard#readme",
  "bugs": {
    "url": "https://github.com/Blaketon/orchboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blaketon/orchboard.git"
  },
  "license": "MIT",
  "author": "Blaketon (https://github.com/Blaketon)",
  "type": "module",
  "bin": {
    "orchboard": "dist/server/main.js"
  },
  "files": [
    "dist",
    "public",
    "!dist/**/*.test.js",
    "!**/*.map"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p src/web/tsconfig.build.json",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node src/server/main.ts --demo",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
